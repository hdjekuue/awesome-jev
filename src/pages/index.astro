---
import Base from '../layouts/Base.astro';
import DecisionTable from '../components/DecisionTable.astro';
import PageBody from '../components/PageBody.astro';
import { CATEGORIES, load } from '../lib/catalog.mjs';
import { COPY } from '../lib/copy.mjs';

const { db, byCat, updated, entries } = load();
const cats = CATEGORIES.filter((cat) => (byCat.get(cat.id) || []).length);
---

<Base lang="en" entries={entries} cats={cats} updated={updated}>
  <DecisionTable lang="en" c={COPY.en} stats={entries.length} />
  <PageBody lang="en" byCat={byCat} updated={updated} entries={entries} />
</Base>